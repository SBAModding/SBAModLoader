<?xml version="1.0" encoding="utf-8"?>
<!-- The top of a store page: a coloured card with decorative shapes, the mod's icon, its name and author. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.SBA.Card.Primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <dev.segually.sbamodloader.ui.ShapeBackdropView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp">

                <TextView
                    android:id="@+id/header_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.SBA.DisplaySmallEmphasized" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/header_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    style="@style/Widget.SBA.IconImage"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/header_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textAppearance="@style/TextAppearance.SBA.Hero"
                android:textColor="?attr/colorOnPrimaryContainer" />

            <TextView
                android:id="@+id/header_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.SBA.BodyLarge"
                android:textColor="?attr/colorOnPrimaryContainer" />

            <TextView
                android:id="@+id/header_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.SBA.BodyMedium"
                android:textColor="?attr/colorOnPrimaryContainer" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dev_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/patch_section_title"
        android:textAppearance="@style/TextAppearance.SBA.RowTitle" />

    <TextView
        android:id="@+id/patch_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.SBA.RowBody" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/patch_url_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/settings_patch_url_hint"
        app:helperText="@string/settings_patch_url_help">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/patch_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_patch_url"
        style="@style/Widget.Material3Expressive.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/settings_patch_url_save" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_load_patch"
        style="@style/Widget.Material3Expressive.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/patch_load_local" />

    <TextView
        android:id="@+id/export_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/export_assemblies_info"
        android:textAppearance="@style/TextAppearance.SBA.RowBody" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_export_assemblies"
        style="@style/Widget.Material3Expressive.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/export_assemblies" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_remove_patch"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/patch_remove" />
</LinearLayout>

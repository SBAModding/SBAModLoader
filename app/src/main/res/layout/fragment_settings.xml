<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp">

    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings"
            android:textAppearance="?attr/textAppearanceHeadlineLarge"
            android:textColor="?attr/colorOnSurface" />

        <include layout="@layout/settings_card_libunity" />
        <include layout="@layout/settings_card_fusion" />
        <include layout="@layout/settings_card_skipfusion" />
        <include layout="@layout/settings_card_developer" />
        <include layout="@layout/settings_dev_section" />
        <include layout="@layout/settings_about" />
        <include layout="@layout/settings_data" />
    </LinearLayout>
</ScrollView>

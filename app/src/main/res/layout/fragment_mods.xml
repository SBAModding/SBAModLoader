<?xml version="1.0" encoding="utf-8"?>
<!-- The page, its large collapsing title and its content are Jetpack Compose: PageFrame / ScrollingPage. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/mods_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The floating action menu and its scrim: ModsFab. It only takes touches where it draws something. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/mods_fab"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>

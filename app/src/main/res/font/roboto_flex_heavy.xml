<?xml version="1.0" encoding="utf-8"?>
<!-- The same font fixed at a heavy weight, for large titles where text styles are not applied. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/roboto_flex"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 750"
        android:fontWeight="400"
        app:font="@font/roboto_flex"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 750"
        app:fontWeight="400" />
    <font
        android:font="@font/roboto_flex"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 750"
        android:fontWeight="700"
        app:font="@font/roboto_flex"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 750"
        app:fontWeight="700" />
</font-family>
